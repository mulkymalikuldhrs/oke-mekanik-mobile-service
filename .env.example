# =============================================================================
# Oke Mekanik - Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=3001

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
# REQUIRED in production! Must be a strong random string (32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In development, a random UUID is auto-generated if not set
JWT_SECRET=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001/api

# --- Database ---
# SQLite database file location (default: server/okemekanik.db)
# DB_PATH=./server/okemekanik.db

# --- Rate Limiting ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# --- Admin Seed Account ---
# Set these to auto-create an admin on first startup
# ADMIN_EMAIL=admin@okemekanik.com
# ADMIN_PASSWORD=ChangeMe123!

# --- Logging ---
LOG_LEVEL=info
