# =============================================================================
# Oke Mekanik - Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=3001

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
# REQUIRED in production! Must be a strong random string (32+ characters)
# In development, a random UUID is auto-generated if not set
JWT_SECRET=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001/api
